{
  "format": 1,
  "id": "stage-manager-cglayerkit-null-connection",
  "name": "Stage Manager CGLayerKit no-connection error-path guard",
  "enabled": true,
  "experimental": true,
  "description": "Trace- and string-verified fix for WindowServer's 'CGLayerKit called back with no connection' path on macOS 13.7.8 (22H730). Runtime tracing places the log at SkyLight+0x3358CE inside layerkit_perform_on_main_thread's block. Direct memory inspection identifies SkyLight+0x3DF740 as the exact 'called back with no connection' format string, distinguishing it from the separate 'not associated with this context' path at +0x3DF6F0. The no-connection path is entered exclusively at SkyLight+0x3357E8 after a NULL connection result. This patch redirects that entry directly to cleanup at +0x335848, before logging and before the NULL callback. It also rolls back the superseded v2 and v3 experiments when present.",
  "target": {
    "process": "WindowServer",
    "module": "SkyLight",
    "builds": [
      "22H730"
    ],
    "architectures": [
      "x86_64"
    ]
  },
  "writes": [
    {
      "name": "rollback-v2-window-update-helper-guard",
      "offset": "0x08CAE5",
      "expected": "e8b4b20700",
      "replacement": "e8c42b2e00"
    },
    {
      "name": "rollback-v2-fetch-helper-guard",
      "offset": "0x1079CC",
      "expected": "e8cd030000",
      "replacement": "e8dd7c2600"
    },
    {
      "name": "rollback-v2-null-helper-trampoline",
      "offset": "0x107D9E",
      "expected": "4885f67405e906792600c3909090",
      "replacement": "9090909090909090909090909090"
    },
    {
      "name": "rollback-v3-post-log-null-callback-skip",
      "offset": "0x33583F",
      "expected": "eb0790909090",
      "replacement": "498b7e2031f6"
    },
    {
      "name": "skip-trace-verified-cglayerkit-no-connection-error-path",
      "offset": "0x3357E8",
      "expected": "e8c5e6d2ff",
      "replacement": "e95b000000"
    }
  ]
}
