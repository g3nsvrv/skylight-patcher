{
  "format": 1,
  "id": "stage-manager-cglayerkit-null-connection",
  "name": "Stage Manager CGLayerKit null-connection callback guard",
  "enabled": true,
  "experimental": true,
  "description": "Trace-verified fix for the WindowServer error 'CGLayerKit called back with no connection'. Runtime tracing places the log inside layerkit_perform_on_main_thread's block at SkyLight+0x3358CE. The no-connection path then deliberately prepares RSI=0 and invokes the client callback at +0x335845. This patch skips only that NULL callback preparation/dispatch path while leaving the valid callback entry at +0x335845 untouched. It also rolls back the disproven v2 helper-call guards if they are present.",
  "target": {
    "process": "WindowServer",
    "module": "SkyLight",
    "builds": [
      "22H730"
    ],
    "architectures": [
      "x86_64"
    ]
  },
  "writes": [
    {
      "name": "rollback-v2-window-update-helper-guard",
      "offset": "0x08CAE5",
      "expected": "e8b4b20700",
      "replacement": "e8c42b2e00"
    },
    {
      "name": "rollback-v2-fetch-helper-guard",
      "offset": "0x1079CC",
      "expected": "e8cd030000",
      "replacement": "e8dd7c2600"
    },
    {
      "name": "rollback-v2-null-helper-trampoline",
      "offset": "0x107D9E",
      "expected": "4885f67405e906792600c3909090",
      "replacement": "9090909090909090909090909090"
    },
    {
      "name": "skip-trace-verified-cglayerkit-null-callback",
      "offset": "0x33583F",
      "expected": "498b7e2031f6",
      "replacement": "eb0790909090"
    }
  ]
}
